---
import Arrow from './Arrow.astro';
import QuietLink from './QuietLink.astro';
import { t, mailto, EMAIL, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="flex flex-col items-start gap-[18px] px-5 py-14 sm:gap-6 sm:px-16 sm:py-18 w980:flex-row w980:items-center w980:justify-between w980:gap-12 border-t border-line" id="contact">
  <h2 class="m-0 font-mono text-[33px] sm:text-[44px] leading-[1.05] sm:leading-[1.02] font-semibold tracking-[-0.035em] text-balance">{s.ctaHead}</h2>
  <div class="flex flex-col items-stretch self-stretch gap-3.5 sm:flex-row sm:items-center sm:self-auto sm:gap-6 w980:flex-none">
    <a class="btn btn-primary h-[52px] gap-2.5 px-[22px] text-sm font-mono font-semibold justify-center" href={mailto(s.ctaSubject)}>
      <span>{s.cta}</span>
      <Arrow />
    </a>
    <QuietLink href={`mailto:${EMAIL}`} class="self-start sm:self-center">{EMAIL}</QuietLink>
  </div>
</section>
