---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="flex flex-col gap-[22px] sm:gap-9 px-5 pt-13 pb-11 sm:px-16 sm:pt-18 sm:pb-16" id="services">
  <div class="flex flex-col items-start gap-3.5 w980:flex-row w980:items-end w980:justify-between w980:gap-12">
    <h2 class="m-0 font-mono text-[29px] sm:text-4xl leading-[1.08] sm:leading-[1.05] font-medium tracking-[-0.03em] text-balance">{s.servicesHead}</h2>
    <p class="m-0 font-mono text-[11.5px] sm:text-[12.5px] leading-relaxed text-dim w980:max-w-[360px] w980:text-right">{s.servicesNote}</p>
  </div>
  <div class="grid grid-cols-1 gap-4.5 sm:grid-cols-2 sm:gap-8 w1180:grid-cols-4">
    {s.services.map((svc) => (
      <article class="flex flex-col gap-[7px] sm:gap-2.5 pt-[15px] sm:pt-5 border-t border-line2">
        <h3 class="m-0 font-mono text-[16.5px] sm:text-lg font-semibold leading-[1.3] tracking-[-0.01em]">{svc.title}</h3>
        <p class="m-0 text-sm sm:text-[14.5px] leading-[1.55] text-muted">{svc.body}</p>
      </article>
    ))}
  </div>
</section>
