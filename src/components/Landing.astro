---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Prompt from './Prompt.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<Layout locale={locale} title={s.title} description={s.description}>
  <div class="flex flex-col min-h-screen min-h-svh">
    <Nav locale={locale} />
    <Hero locale={locale} />
    <Prompt />
  </div>
</Layout>
