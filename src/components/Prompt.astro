---
import { EMAIL } from '../i18n/ui';
---

<div class="flex items-center gap-2.5 sm:gap-3.5 px-5 py-3 sm:px-16 sm:py-3.5 border-y border-line font-mono text-[11.5px] sm:text-[12.5px] text-muted tracking-[0.02em] whitespace-nowrap overflow-hidden">
  <span class="text-primary">yoku@ops:~$</span>
  <span>scope --web --api --cloud<span class="hidden sm:inline"> --network --red-team</span></span>
  <span class="cursor-blink block w-[7px] h-[13px] sm:w-2 sm:h-3.5 bg-primary" aria-hidden="true"></span>
  <a class="ml-auto hidden sm:inline text-muted hover:text-base-content transition-colors" href={`mailto:${EMAIL}`}>{EMAIL}</a>
</div>
