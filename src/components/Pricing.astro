---
import Arrow from './Arrow.astro';
import Ghost from './Ghost.astro';
import { t, mailto, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const p = s.pricing;
const rows = ['scope', 'roles', 'testing', 'retest'] as const;
---

<section
  class="grid grid-cols-1 items-start gap-5 px-5 py-13 sm:gap-x-18 sm:gap-y-14 sm:px-16 sm:pt-18 sm:pb-16 w1180:grid-cols-[440px_minmax(0,1fr)] border-t border-line"
  id="pricing"
>
  <div class="flex flex-col gap-5 sm:gap-6 sm:max-w-[640px] w1180:max-w-none">
    <h2 class="m-0 font-mono text-[29px] sm:text-4xl leading-[1.08] sm:leading-[1.05] font-medium tracking-[-0.03em] text-balance">{p.head}</h2>
    <p class="m-0 text-[15px] sm:text-[17px] leading-normal text-soft text-pretty">{p.sub}</p>

    <div class="card rounded-md bg-card border border-white/12 overflow-hidden">
      <div class="flex items-center justify-between px-3.5 py-[11px] sm:px-4.5 sm:py-3 border-b border-line font-mono text-[10.5px] sm:text-xs tracking-[0.06em] text-muted">
        <span>{p.flash.head}</span>
        <span class="badge badge-outline badge-sm border-white/18 text-muted rounded-[3px] text-[9px] sm:text-[10px] tracking-[0.14em]">{p.flash.tag}</span>
      </div>
      <div class="flex flex-col gap-3.5 sm:gap-4 px-3.5 py-4 sm:px-4.5 sm:py-5">
        <div class="flex items-baseline gap-3 sm:gap-3.5">
          <span class="font-mono text-4xl sm:text-[44px] font-semibold leading-none tracking-[-0.03em] text-primary">{p.flash.price}</span>
          <span class="font-mono text-[11.5px] sm:text-[12.5px] text-muted">{p.flash.once}</span>
        </div>
        <div class="flex flex-col border-t border-white/10">
          {p.flash.checks.map((check) => (
            <div class="flex items-start gap-3 sm:gap-[13px] py-2.5 sm:py-[11px] border-b border-white/10">
              <svg class="flex-none mt-[3px] text-primary" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8.5l3 3 7-7"></path>
              </svg>
              <span class="text-[13.5px] sm:text-[15px] leading-normal text-body">{check}</span>
            </div>
          ))}
        </div>
        <p class="m-0 font-mono text-[11px] sm:text-xs leading-relaxed text-dim">{p.flash.note}</p>
      </div>
      <div class="flex items-center gap-2.5 px-3.5 py-2.5 sm:px-4.5 sm:py-[11px] border-t border-line font-mono text-[10.5px] sm:text-[11.5px] text-muted">
        <span class="status bg-primary" aria-hidden="true"></span>
        <span>{p.flash.credit}</span>
      </div>
    </div>

    <a class="btn btn-primary h-[52px] gap-2.5 px-[22px] text-sm font-mono font-semibold justify-center sm:self-start" href={mailto(p.flash.ctaSubject)}>
      <span>{p.flash.cta}</span>
      <Arrow />
    </a>
  </div>

  <div class="flex flex-col gap-3.5 sm:gap-5 w1180:pt-1.5">
    <div class="flex items-baseline justify-between gap-4 sm:gap-6 mt-3 sm:mt-0">
      <h3 class="m-0 font-mono text-[16.5px] sm:text-lg font-semibold leading-[1.3] tracking-[-0.01em]">{p.tiersHead}</h3>
      <span class="font-mono text-[11px] sm:text-[12.5px] text-dim text-right">{p.tiersNote}</span>
    </div>

    <table class="hidden w1180:table w-full table-fixed border-collapse border-t border-line2 font-mono text-[13px] leading-normal [&_th]:pl-0 [&_td]:pl-0">
      <caption class="sr-only">{p.tiersCaption}</caption>
      <colgroup><col class="w-[120px]" /><col /><col /><col /></colgroup>
      <thead>
        <tr>
          <td></td>
          {p.tiers.map((tier) => (
            <th scope="col" class="text-left align-bottom font-normal py-4 pr-6 last:pr-0 border-b border-line2">
              <span class="block text-[15px] font-semibold text-base-content">{tier.name}</span>
              <span class="block mt-1 text-[17px] font-semibold tracking-[-0.02em] text-primary whitespace-nowrap">{tier.price}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row" class="text-left align-top font-normal text-muted py-[13px] pr-6 border-b border-white/10">{p.rowLabels[row]}</th>
            {p.tiers.map((tier) => (
              <td class="text-left align-top text-body py-[13px] pr-6 last:pr-0 border-b border-white/10">{tier[row]}</td>
            ))}
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          {p.tiers.map((tier) => (
            <td class="pt-4.5 pb-0 pr-6 last:pr-0">
              <Ghost href={mailto(tier.ctaSubject)} class="w-full">{tier.cta}</Ghost>
            </td>
          ))}
        </tr>
      </tfoot>
    </table>

    <div class="grid grid-cols-1 w980:grid-cols-3 gap-3.5 sm:gap-4 w1180:hidden">
      {p.tiers.map((tier) => (
        <article class="card rounded-md bg-card border border-white/12 flex flex-col gap-3 px-3.5 py-4.5 sm:px-4.5 sm:py-5">
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-mono text-[16.5px] sm:text-[17px] font-semibold text-base-content">{tier.name}</span>
            <span class="font-mono text-[17px] font-semibold tracking-[-0.02em] text-primary whitespace-nowrap">{tier.price}</span>
          </div>
          <dl class="m-0 flex flex-col border-t border-white/10 font-mono text-xs sm:text-[12.5px] leading-normal">
            {rows.map((row) => (
              <div class="flex justify-between gap-3 py-2 sm:py-2.5 border-b border-white/10">
                <dt class="text-muted">{p.rowLabels[row]}</dt>
                <dd class="m-0 text-body text-right">{tier[row]}</dd>
              </div>
            ))}
          </dl>
          <Ghost href={mailto(tier.ctaSubject)} class="mt-auto">{tier.cta}</Ghost>
        </article>
      ))}
    </div>
  </div>

  <div class="w1180:col-span-full card rounded-md bg-card border border-white/12 flex flex-col items-stretch gap-3 px-3.5 py-4 mt-3 sm:mt-0 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-8 sm:px-6 sm:py-5 w980:flex-nowrap">
    <div class="contents sm:flex sm:flex-col sm:gap-1.5 sm:flex-1 sm:basis-full w980:basis-0">
      <h3 class="m-0 font-mono text-[16.5px] sm:text-lg font-semibold leading-[1.3] tracking-[-0.01em]">{p.cont.head}</h3>
      <p class="m-0 order-2 sm:order-none text-[13px] sm:text-[14.5px] leading-normal text-muted text-pretty">{p.cont.copy}</p>
    </div>
    <div class="order-1 sm:order-none flex flex-col items-stretch border-t border-white/10 font-mono sm:flex-row sm:items-center sm:gap-8 sm:flex-none sm:border-0">
      {p.cont.prices.map((price) => (
        <div class="flex flex-row items-baseline justify-between gap-3 py-2 border-b border-white/10 sm:flex-col sm:items-start sm:gap-[3px] sm:py-0 sm:border-0">
          <span class="text-[12.5px] text-body sm:text-xs sm:text-muted">{price.label}</span>
          <span class="text-[12.5px] sm:text-[17px] font-semibold tracking-[-0.02em] text-primary whitespace-nowrap">{price.price}</span>
        </div>
      ))}
    </div>
    <div class="order-3 sm:order-none sm:flex-none">
      <a class="hidden sm:inline-flex btn btn-outline h-11 px-[18px] text-[13px] font-mono font-semibold rounded border-white/18 text-base-content hover:bg-transparent hover:text-white hover:border-white/45" href={mailto(p.cont.ctaSubject)}>{p.cont.cta}</a>
      <a class="sm:hidden self-start font-mono text-[13px] text-muted hover:text-base-content border-b border-white/18 hover:border-base-content pb-[2px] transition-colors" href={mailto(p.cont.ctaSubject)}>{p.cont.cta}</a>
    </div>
  </div>
</section>
