---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { locales, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const site = Astro.site ?? new URL('https://yoku.chrom.ar');
const canonical = new URL(localePath(locale), site);
const ogImage = new URL(`/og-${locale}.png`, site);
const ogLocale = { en: 'en_US', es: 'es_ES' }[locale];
const ogAlternate = locales.filter((l) => l !== locale).map((l) => ({ en: 'en_US', es: 'es_ES' })[l]);
---

<!doctype html>
<html lang={locale} data-theme="yoku">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en'), site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yoku" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternate.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-instrument-sans" preload />
  </head>
  <body class="bg-base-100 text-base-content">
    <slot />
  </body>
</html>
