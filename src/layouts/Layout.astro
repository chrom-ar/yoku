---
import '../styles/global.css';
import { locales, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const site = Astro.site ?? new URL('https://yoru.chrom.ar');
const canonical = new URL(localePath(locale), site);
---

<!doctype html>
<html lang={locale} data-theme="yoru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en'), site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Instrument+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body class="bg-base-100 text-base-content">
    <slot />
  </body>
</html>
