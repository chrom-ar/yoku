---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { t, ui, localePath, mailto } from '../i18n/ui';

// GitHub Pages serves this single file for every missing path, so it is
// rendered in English and switched to Spanish on the client when the visitor
// prefers it (same rule as LangRedirect).
const en = t('en');
const es = ui.es;
---

<Layout locale="en" title={en.notFoundTitle} description={en.notFoundSub} path="/404" noindex>
  <div class="flex flex-col min-h-screen min-h-svh">
    <Nav locale="en" />

    <main class="flex-1 flex items-center px-5 py-8 md:px-16 md:py-10">
      <div class="flex flex-col gap-5 md:gap-7 md:max-w-[620px]">
        <p class="flex items-center gap-2.5 md:gap-3 m-0 font-mono text-[11px] md:text-xs tracking-[0.12em] uppercase text-muted">
          <svg class="text-primary" width="6" height="6" viewBox="0 0 6 6" aria-hidden="true">
            <circle cx="3" cy="3" r="3" fill="currentColor"></circle>
          </svg>
          <span data-i18n="eyebrow">{en.notFoundEyebrow}</span>
        </p>
        <h1 class="m-0 font-mono font-semibold text-5xl md:text-[64px] xl:text-[80px] leading-[0.98] tracking-[-0.035em] text-balance" data-i18n="headline">{en.notFoundHeadline}</h1>
        <p class="m-0 text-base md:text-[19px] leading-normal md:leading-[1.55] text-[#a1a1aa] max-w-[540px] text-pretty" data-i18n="sub">{en.notFoundSub}</p>
        <div class="flex mt-2">
          <a class="btn btn-primary btn-lg font-mono font-semibold" href={localePath('en')} data-i18n="home" data-home-en={localePath('en')} data-home-es={localePath('es')}>
            <span>{en.notFoundHome}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h10"></path>
              <path d="M9 4l4 4-4 4"></path>
            </svg>
          </a>
        </div>
      </div>
    </main>

    <footer class="flex items-center gap-2.5 md:gap-3.5 px-5 py-3 md:px-16 md:py-3.5 border-t border-line font-mono text-[11.5px] md:text-[12.5px] text-muted tracking-[0.02em] whitespace-nowrap overflow-hidden">
      <span class="text-primary">yoku@ops:~$</span>
      <span>curl -I <span id="path" class="text-base-content">/</span></span>
      <span class="hidden md:inline text-dim">→ HTTP/2 404</span>
      <span class="cursor-blink block w-[7px] h-[13px] md:w-2 md:h-3.5 bg-primary" aria-hidden="true"></span>
    </footer>
  </div>
</Layout>

<script
  is:inline
  define:vars={{
    es: { eyebrow: es.notFoundEyebrow, headline: es.notFoundHeadline, sub: es.notFoundSub, home: es.notFoundHome, title: es.notFoundTitle },
    nav: { contact: es.contact, cta: es.cta, ctaHref: mailto(es.ctaSubject), switchLabel: 'EN', switchHref: localePath('en') },
  }}
>
  (function () {
    try {
      var el = document.getElementById('path');
      if (el) el.textContent = location.pathname;
      var pref = localStorage.getItem('lang');
      var first = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
      if ((pref || (first.indexOf('es') === 0 ? 'es' : 'en')) !== 'es') return;
      document.documentElement.lang = 'es';
      document.title = es.title;
      document.querySelectorAll('[data-i18n]').forEach(function (n) {
        var key = n.getAttribute('data-i18n');
        var target = n.querySelector('span') || n;
        target.textContent = es[key];
        if (n.dataset.homeEs) n.setAttribute('href', n.dataset.homeEs);
      });
      var contact = document.querySelector('[data-nav="contact"]');
      if (contact) contact.textContent = nav.contact;
      var cta = document.querySelector('[data-nav="cta"]');
      if (cta) { cta.textContent = nav.cta; cta.setAttribute('href', nav.ctaHref); }
      var sw = document.querySelector('a[data-lang]');
      if (sw) { sw.textContent = nav.switchLabel; sw.setAttribute('href', nav.switchHref); sw.setAttribute('hreflang', 'en'); sw.setAttribute('lang', 'en'); sw.dataset.lang = 'en'; }
    } catch (e) {}
  })();
</script>
